CREW_API_DOMAIN=api.example.invalid
CREW_REVIEW_DOMAIN=review.example.invalid
CREW_REVIEW_USER=reviewers
# Use `caddy hash-password`. Single quotes preserve the literal dollar signs.
CREW_REVIEW_PASSWORD_HASH='REPLACE_WITH_CADDY_HASH'
CREW_SIGNER_WORKFLOW=wowlocal/crew18-sim/.github/workflows/simulator-build.yml
# Exact commit containing the reviewed reusable workflow; never a branch name.
CREW_SIGNER_DIGEST=REPLACE_WITH_40_CHARACTER_COMMIT_SHA
# Optional read access for attestations in private repositories. Keep local, never commit.
GH_TOKEN=
