  "components": {
    "schemas": {
      "CaseAvailability": {
        "properties": {
          "is_open": {
            "type": "boolean",
            "title": "Is Open"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "is_open"
        ],
        "title": "CaseAvailability"
      },
      "CaseInput": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Id"
          },
          "day": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Day"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "prompt": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Prompt"
          },
          "source_repo": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "title": "Source Repo"
          },
          "base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "title": "Base Commit"
          },
          "project": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Project"
          },
          "scheme": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$",
            "title": "Scheme"
          },
          "runtime_version": {
            "type": "string",
            "pattern": "^\\d{1,2}\\.\\d{1,2}(\\.\\d{1,2})?$",
            "title": "Runtime Version"
          },
          "is_open": {
            "type": "boolean",
            "title": "Is Open",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "day",
          "title",
          "prompt",
          "source_repo",
          "base_commit",
          "project",
          "scheme",
          "runtime_version"
        ],
        "title": "CaseInput"
      },
      "CompletionInput": {
        "properties": {
          "lease_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Lease Token"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Outcome"
          },
          "source_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Commit"
          },
          "summary": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lease_token",
          "outcome",
          "summary"
        ],
        "title": "CompletionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeaseInput": {
        "properties": {
          "lease_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Lease Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lease_token"
        ],
        "title": "LeaseInput"
      },
      "SubmissionInput": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Case Id"
          },
          "answer": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "answer"
        ],
        "title": "SubmissionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
